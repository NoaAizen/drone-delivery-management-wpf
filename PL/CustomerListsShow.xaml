<Window x:Name="CustomerListsShow1" x:Class="PL.CustomerListsShow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="CustomerListsShow" Height="450" Width="800"  >
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="97*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="400*"/>
            <RowDefinition Height="60*"/>
        </Grid.RowDefinitions>
        <ListView x:Name="customerlist" Grid.Row="1" MouseDoubleClick="GetActionsCustomer" ItemsSource="{Binding}">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding NumberOfParcelSentAndDelivered}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
        <Button Content="Add a new customer" HorizontalAlignment="Stretch"  Grid.Row="2" VerticalAlignment="Stretch"  Click="AddCustomerClick"/>
        <Button x:Name="Close" Content="Close" HorizontalAlignment="Left" Margin="-3,-2,0,0" VerticalAlignment="Top" Height="41" Width="95" Click="CloseClick"/>
        
        <Button Content="Button"
                Click="group" HorizontalAlignment="Left" Margin="364,1,0,0" VerticalAlignment="Top" Height="33"/>

    </Grid>

</Window>
