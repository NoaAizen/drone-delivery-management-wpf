<Window x:Name="CustomerListsShow1" x:Class="PL.CustomerListsShow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Icon="image/לוגו.png"

        Title="CustomerListsShow" Height="450" Width="800" WindowStyle="None" MouseDown="moveWindow" >
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="312*"/>
            <ColumnDefinition Width="223*"/>
            <ColumnDefinition Width="265*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="313*"/>
            <RowDefinition Height="53*"/>
        </Grid.RowDefinitions>
        <ListView x:Name="customerlist" Grid.Row="2" MouseDoubleClick="GetActionsCustomer" ItemsSource="{Binding}" Grid.ColumnSpan="3">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding Phone}"/>
                    <GridViewColumn Header="Number Of Parcel Sent And Delivered" DisplayMemberBinding="{Binding NumberOfParcelSentAndDelivered}"/>
                    <GridViewColumn Header="Number Of Parcel Sent But Not Yet Delivered" DisplayMemberBinding="{Binding NumberOfParcelSentButNotYetDelivered}"/>
                    <GridViewColumn Header="Number Of Parcel Received" DisplayMemberBinding="{Binding NumberOfParcelReceived}"/>
                    <GridViewColumn Header="Number Of Parcel On The Way To The Customer" DisplayMemberBinding="{Binding NumberOfParcelOnTheWayToTheCustomer}"/>
                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Name" FontWeight="Bold" FontSize="14" Text="{Binding Name}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
     
        <Button Content="Add a new customer"  Grid.Row="3"  Click="AddCustomerClick" FontSize="20" FontWeight="Bold" Grid.ColumnSpan="3" Margin="0,4,0,0"/>
        <Button x:Name="Close" Content="Close" HorizontalAlignment="Left" Margin="-3,-2,0,0" VerticalAlignment="Top" Height="41" Width="95" Click="CloseClick" FontWeight="Bold" FontSize="20"/>
        <Button x:Name="NumberOfParcelReceivedGroing" Content="Parcel received" Grid.Column="2"  Click="NumberOfParcelReceivedClick"  FontSize="20" FontWeight="Bold"  Grid.Row="1"/>
      


    </Grid>

</Window>
