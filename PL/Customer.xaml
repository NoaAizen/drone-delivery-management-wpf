<Window x:Class="PL.Customer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL" d:DataContext="{d:DesignInstance Type=local:CustomerPo}"
        mc:Ignorable="d"
        Title="Customer" Height="450" Width="800" WindowStyle="None" MouseDown="moveWindow">
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid x:Name="MainGrid">
        <Grid x:Name="Actions" Visibility="Visible"  >
            <Grid.RowDefinitions>
                <RowDefinition Height="59*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="39*"/>
                <RowDefinition Height="78*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions >
            <Label Content="Customer:"  Grid.Column="2"  Grid.Row="0" FontWeight="Bold" FontSize="36" Grid.ColumnSpan="3" Margin="76,-2,48,2"   />
            <Label Content="Id:" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Name:" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Phone:" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Longitude:" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Latitude:" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <TextBox x:Name="idText" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Id}" />
            <TextBox x:Name="NameText" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Name}" />
            <TextBox x:Name="PhoneText" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Phone}"/>
            <TextBox x:Name="longitudeText" Grid.Column="2" Grid.Row="4" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Longitude}" />
            <TextBox x:Name="latitudeText" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Latitude}"/>
            <Label Content="Longitude:" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Latitude:" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="parcels from customer:" Grid.Column="2" Grid.ColumnSpan="3" Margin="110,59,61,0" Grid.RowSpan="2"/>
            <Label Content="parcels to customer:" Grid.Row= "6" Grid.ColumnSpan="2" Margin="102,0,4,39" Grid.RowSpan="2"/>
            <ListView x:Name="ParcelAtCustomerFromCustomer" Grid.Column="4" ItemsSource="{Binding Path=ParcelAtCustomerFromCustomer}" Grid.ColumnSpan="3" Margin="15,56,-2,12" Grid.RowSpan="6" RenderTransformOrigin="0.5,0.5" MouseDoubleClick="ParcelAtCustomerFromCustomerClick"  >
                <ListView.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleY="-0.751"/>
                        <RotateTransform/>
                        <TranslateTransform Y="-1.487"/>
                    </TransformGroup>
                </ListView.RenderTransform>
            </ListView>
            <ListView x:Name="ParcelAtCustomerToCustomer" Grid.Column="2" Grid.Row="6" Grid.ColumnSpan="4" Grid.RowSpan="4" Margin="7,9,110,21" ItemsSource="{Binding Path=ParcelAtCustomerToCustomer}" MouseDoubleClick="ParcelAtCustomerToCustomerClick" >
                <ListView.View>
                    <GridView>
                        <GridViewColumn/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Image  Source="image/לוגו קטן בלי רקע (2).png"  Grid.ColumnSpan="2" Grid.RowSpan="4" Margin="30,-3,0,6" HorizontalAlignment="Left" Width="113"/>
            <Image Margin="94,-32,114,15" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png" Grid.RowSpan="2" Grid.ColumnSpan="3"/>
            <Image Margin="-19,27,69,35" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png" Grid.RowSpan="5" Grid.ColumnSpan="2"/>
            <Button x:Name="Updat" Content="Update" Grid.Column="6" HorizontalAlignment="Left" Margin="2,15,0,0" Grid.Row="9" VerticalAlignment="Top" Height="41" Width="102" Click="UpdatClick"/>
            <Button x:Name="CloseActions" Content="close" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Click="CloseClick" FontSize="20" FontWeight="Bold"/>

        </Grid>
        <Grid x:Name="AddCustomerGrid" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="193*"/>
                <ColumnDefinition Width="200*"/>
            </Grid.ColumnDefinitions >
            <Label Content="Enter the details of the new customer:" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Grid.ColumnSpan="5" Grid.RowSpan="4"/>
            <Label Content="Id:" Grid.Column="1" Grid.Row="2" Margin="0,0,0,36" Grid.RowSpan="2" FontWeight="Bold"/>
            <Label Content="Name:" Grid.Column="1" Grid.Row="3" Margin="0,0,0,36" Grid.RowSpan="2" FontWeight="Bold"/>
            <Label Content="Phone:" Grid.Column="1" Grid.Row="4" FontWeight="Bold"/>
            <Label Content="Longitude:" Grid.Column="1" Grid.Row="5" Margin="0,36,0,0" Grid.RowSpan="2" FontWeight="Bold"/>
            <Label Content="Latitude:" Grid.Column="1" Grid.Row="4" Margin="0,36,0,0" Grid.RowSpan="2" FontWeight="Bold"/>
            <TextBox x:Name="idteaxt" Grid.Column="2" Grid.Row="2" TextChanged="IdClick" Margin="0,0,0,36" Grid.RowSpan="2" Grid.ColumnSpan="2" />
            <TextBox x:Name="nameteaxt"  Grid.Column="2" Grid.Row="3 " TextChanged="NameClick" Margin="0,0,0,36" Grid.RowSpan="2" Grid.ColumnSpan="2" />
            <TextBox x:Name="latitudeteaxt" Grid.Column="2" Grid.Row="4" TextChanged="LatitudetClick" Margin="0,36,0,0" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
            <TextBox x:Name="phoneeteaxt" Grid.Column="2" Grid.Row="4" TextChanged="PhoneClick" Grid.ColumnSpan="2"/>
            <TextBox x:Name="longitudetext" Grid.Column="2" Grid.Row="5" TextChanged="LongitudClick" Margin="0,36,0,0" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
            <Button x:Name="AddNewCustomer" Content="Add customer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  FontWeight="Heavy" Grid.Column="3"  Grid.Row="8"  Click="AddNewCustomerClick"/>
            <Button x:Name="Close" Content="Cancel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  FontWeight="Heavy" Grid.Column="1"  Grid.Row="8" Click="CloseClick"/>
            <Image  Source="image/לוגו קטן בלי רקע (2).png" Grid.RowSpan="4" Margin="24,-34,0,34" HorizontalAlignment="Left" Grid.ColumnSpan="2"/>
            <Image Margin="143,-25,79,8" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
            <Image Margin="-19,43,182,19" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png" Grid.RowSpan="5" Grid.ColumnSpan="2"/>
        </Grid>
    </Grid>

</Window>
