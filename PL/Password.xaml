<Window x:Class="PL.Password"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Password" Height="450" Width="450">
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid x:Name="MainGrid">
        <Grid x:Name="PasswordManager" Visibility="Hidden">
        <PasswordBox x:Name="PasswordM" HorizontalAlignment="Left" Margin="170,181,0,0" VerticalAlignment="Top" Width="120" Height="26" MaxLength="6"  />
        <Button Content="Login" HorizontalAlignment="Left" Margin="242,235,0,0" VerticalAlignment="Top" Click="LoginClick" Height="35" Width="91"/>
        <Button Content="Close" HorizontalAlignment="Left" Margin="123,235,0,0" VerticalAlignment="Top" Click="ClosedClick" Height="35" Width="91"/>
        <TextBox x:Name="Username" HorizontalAlignment="Left" Margin="170,153,0,0"  TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="26" />
        <Label Content="Enter a username and password:" HorizontalAlignment="Left" Margin="20,86,0,0" VerticalAlignment="Top" Width="426" FontSize="25" FontWeight="Bold"/>
        <Label Content="Username:" HorizontalAlignment="Left" Margin="97,152,0,0" VerticalAlignment="Top"/>
        <Label Content="Password:" HorizontalAlignment="Left" Margin="97,180,0,0" VerticalAlignment="Top"/>

    </Grid>
 </Grid>

</Window>
