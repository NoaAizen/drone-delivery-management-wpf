<Window x:Class="PL.Password"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Password" Height="350" Width="412" WindowStyle="None" MouseDown="moveWindow">
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid x:Name="MainGrid" Margin="0,13,0,0">
        
        <Grid x:Name="PasswordManager" Visibility="Hidden" Margin="0,0,0,-1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="47*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>


            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions >
            <PasswordBox x:Name="PasswordM" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"  MaxLength="6" Grid.Column="2"  Grid.Row="3"/>
            <Button Content="Login" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="LoginClickManager" Grid.Column="2" Grid.Row="5"/>
            <Button Content="Close" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="ClosedClick" Grid.Column="1"  Grid.Row="5"/>
            <TextBox x:Name="Username" VerticalAlignment="Stretch" Grid.Column="2" Grid.Row="2" />
            <Label Content="Enter a username and password:" VerticalAlignment="Stretch"  HorizontalAlignment="Center"  FontSize="20" FontWeight="Bold" Grid.ColumnSpan="4" Grid.Row="1"/>
            <Label Content="Username:" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Grid.Column="1"  Grid.Row="2"/>
            <Label Content="Password:" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Grid.Column="1" Grid.Row="3" />

        </Grid>

        <Grid x:Name="PasswordClient" Visibility="Hidden" Margin="0,0,0,-1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="47*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
                <RowDefinition Height="31*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions >
            <Button Content="Login" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="LoginClicentClick" Grid.Column="2" Grid.Row="5"/>
            <Button Content="Close" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="ClosedClick" Grid.Column="1"  Grid.Row="5"/>
            <TextBox x:Name="UsernameClient" VerticalAlignment="Stretch" Grid.Column="2" Grid.Row="2" />
            <Label Content="Enter a name,id and password:" VerticalAlignment="Stretch"  HorizontalAlignment="Center"  FontSize="20" FontWeight="Bold" Grid.ColumnSpan="4" Grid.Row="1"/>
            <Label Content="Name:" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Grid.Column="1"  Grid.Row="2"/>
            <Label Content="Password:" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Grid.Column="1" Grid.Row="4" />
            <PasswordBox x:Name="PasswordC" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"  MaxLength="6" Grid.Column="2"  Grid.Row="4"/>
            <Label Content="Id:" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Grid.Column="1" Grid.Row="3" />
            <TextBox x:Name="IdText" VerticalAlignment="Stretch" Grid.Column="2" Grid.Row="3" />

        </Grid>
    </Grid>

</Window>
