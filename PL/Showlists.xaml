        <Label Content="Welcome to the  "   HorizontalAlignment="Left" Margin="306,109,0,0" VerticalAlignment="Top" Width="291" FontSize="30" FontWeight="Bold"/>
        <Image Stretch="Fill" Source="image/לוגו קטן בלי רקע (2).png" Margin="36,-28,326,184"/>
        <Image Margin="160,4,362,293" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png"/>
        <Image Margin="-16,58,586,253" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png"/>
