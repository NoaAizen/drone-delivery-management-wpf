<Window x:Class="PL.Showlists"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Showlists" Height="450" Width="800">
    <Window.Resources>
        <Color x:Key="SolidColorBrushColor1">#FFAA0D0D</Color>
        <Color x:Key="SolidColorBrushColor2">#FFF00A0A</Color>
        <Color x:Key="SolidColorBrushColor3">#FF684564</Color>
    </Window.Resources>

    <Grid>
        <Button Content="View the drones list" Margin="250,276,358,101" Click="ShowDronesButton_Click" FontSize="18" FontStretch="SemiExpanded" BorderBrush="{x:Null}" BorderThickness="1,0,1,1" FontWeight="Bold" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="5.185"/>
                    <RotateTransform/>
                    <TranslateTransform X="-2.588"/>
                </TransformGroup>
            </Button.RenderTransform>
            <Button.Foreground>
                <SolidColorBrush Color="{DynamicResource SolidColorBrushColor3}"/>
            </Button.Foreground>
        </Button>
        <Button Content="View the stations list" HorizontalAlignment="Left" Margin="495,160,0,0" VerticalAlignment="Top" Height="59" Width="144" Click="ShowStationsListClick"/>
        <Button Content="View the customer list" HorizontalAlignment="Left" Margin="572,314,0,0" VerticalAlignment="Top" Height="64" Width="127" Click="CustomerListClick" RenderTransformOrigin="2.085,-0.758"/>
        <Button Content="View the parcels list" HorizontalAlignment="Left" Margin="36,273,0,0" VerticalAlignment="Top" Height="60" Width="188" Click="ShowParcelsListClick"/>
    </Grid>
</Window>
