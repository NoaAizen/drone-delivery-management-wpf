<Window x:Class="PL.Drone"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL" d:DataContext="{d:DesignInstance Type=local:DronePO}"
        mc:Ignorable="d"
        Icon="image/2.jpeg"
        
       Title="Drone" Height="450" Width="800" >
    <Window.Resources>
        <Color x:Key="SolidColorBrushColor1">#FFE68A76</Color>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>

    <Grid x:Name="MainGrid">
        <Grid x:Name="AddDroneGrid" Visibility="Visible"  >
            <Label Content="Enter the details of the new drone:" HorizontalAlignment="Left" Margin="223,70,0,0" VerticalAlignment="Top" Width="425" FontSize="25" FontWeight="Bold"/>
            <TextBox x:Name="id" Margin="391,129,262,0" TextWrapping="Wrap" VerticalAlignment="Top" TextChanged="IdClick" Height="30"/>

            <TextBox x:Name="model" HorizontalAlignment="Left" Margin="391,162,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="147" TextChanged="modelClick" Height="30" />
            <ComboBox x:Name="maxWeight" HorizontalAlignment="Left" Margin="391,195,0,0"  VerticalAlignment="Top" Width="146" SelectionChanged="maxclick" Height="33" />
            <Button x:Name="AddNewDrone" Content="Add drone" HorizontalAlignment="Left" Margin="440,322,0,0" VerticalAlignment="Top" Height="41" Width="116" Click="AddNewDroneClick"  FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"/>
            <Label Content="Id:" HorizontalAlignment="Left" Margin="275,128,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.093,1.715" Width="37" Height="28" FontWeight="Bold" FontSize="15" />
            <Label Content="Model:" HorizontalAlignment="Left" Margin="273,164,0,0" VerticalAlignment="Top" Width="59" Height="27" FontWeight="Bold" FontSize="15" />
            <Label Content="Max weight:" HorizontalAlignment="Left" Margin="273,197,0,0" VerticalAlignment="Top" Width="104" Height="32" FontWeight="Bold" FontSize="15"/>
            <TextBox x:Name="stationId" Margin="392,232,262,0" VerticalAlignment="Top" TextChanged="stationidclick" Height="30"/>
            <Label Content="Station id:" HorizontalAlignment="Left" Margin="274,232,0,0" VerticalAlignment="Top" Width="84" RenderTransformOrigin="0.5,0.5" FontWeight="Bold" FontSize="15" />
            <Button x:Name="Close" Content="Cancel" HorizontalAlignment="Left" Margin="296,322,0,0" VerticalAlignment="Top" Click="CloseClick" Height="40" Width="121" FontWeight="Bold" FontSize="20" FontFamily="Segoe UI"/>
            <Image Stretch="Fill" Source="image/לוגו קטן בלי רקע (2).png" Margin="36,-28,455,269"/>
            <Image Margin="96,-36,426,333" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png"/>
            <Image Margin="-8,25,578,286" Stretch="Fill" Source="/image/לוגו קטן בלי רקע (2).png"/>
        </Grid>


        <Grid x:Name="Actions" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions >
            <Label Content="Id:" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Model:" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Max weight:" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Status:" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Battery:" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Longitude:" Grid.Column="1" Grid.Row="6" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Latitude:" Grid.Column="1" Grid.Row="7" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Parcel Number:" Grid.Column="1" Grid.Row="8" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <TextBox x:Name="idText" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Id}" />
            <TextBox x:Name="modelText" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Model}" />
            <TextBox x:Name="batteryText" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Battery}"/>
            <TextBox x:Name="longitudeText" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Longitude}" />
            <TextBox x:Name="latitudeText" Grid.Column="2" Grid.Row="7" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Latitude}"/>
            <TextBox x:Name="parcelNumberText" Grid.Column="2" Grid.Row="8" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=ParcelTransferredNumber}" />
            <ComboBox x:Name="maxWeightText" Grid.Column="2" HorizontalAlignment="Stretch" Grid.Row="3" VerticalAlignment="Stretch" SelectedItem="{Binding Path=MaxWeight}"/>
            <ComboBox x:Name="statusText" Grid.Column="2" HorizontalAlignment="Stretch" Grid.Row="4" VerticalAlignment="Stretch" Text="{Binding Path=Status}"/>
            <Button x:Name="UpdateModel" Content="Updat model" Click="UpdateModelClick" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Grid.Column="4" Grid.Row="2" />
            <Button x:Name="closed" Content="close" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Button_Click" Grid.Column="0" Grid.Row="0"/>
            <Button x:Name="charging" Content="Charging" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="3" Click="ChargingClick" Grid.Column="4"/>
            <Button x:Name="Release" Content="Release" HorizontalAlignment="Stretch" Grid.Row="4" VerticalAlignment="Stretch" Click="ReleaseClick" Grid.Column="4"/>
            <Button x:Name="Collection" Content="Collection" HorizontalAlignment="Stretch"  Grid.Row="5" VerticalAlignment="Stretch" Click="CollectionClick" Grid.Column="4"/>
            <Button x:Name="Delivery" Content="Delivery"  Grid.Row="7" Click="DeliveryClick" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="4"/>
            <Button x:Name="Assignment" Content="Assignment" HorizontalAlignment="Stretch"  Grid.Row="6" VerticalAlignment="Stretch" Click="AssignmentClick" Grid.Column="4"/>
            <Button x:Name="ParcelTransfer" Content="Parcel in transfer" Grid.Column="4" HorizontalAlignment="Stretch"  Grid.Row="9" VerticalAlignment="Stretch" Click="ParcelInTransferClick" Height="36" FontWeight="UltraBold" FontStyle="Normal">
                <Button.Background>
                    <SolidColorBrush Color="{DynamicResource SolidColorBrushColor1}"/>
                </Button.Background>
            </Button>
        </Grid>
    </Grid>
</Window>
