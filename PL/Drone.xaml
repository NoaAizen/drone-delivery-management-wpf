<Window x:Class="PL.Drone"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Drone" Height="450" Width="800">
    <Grid x:Name="MainGrid">
        <Grid x:Name="AddDroneGrid" Visibility="Hidden" >
            <Label Content="Enter the details of the new drone:" HorizontalAlignment="Center" Margin="0,27,0,0" VerticalAlignment="Top" Width="272" FontSize="16"/>
            <TextBox x:Name="id" HorizontalAlignment="Left" Margin="454,134,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
            <TextBox x:Name="model" HorizontalAlignment="Left" Margin="454,178,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" />
            <TextBox x:Name="maxWeight" HorizontalAlignment="Left" Margin="454,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" />
            <Button x:Name="AddNewDrone" Content="Add drone" HorizontalAlignment="Left" Margin="572,328,0,0" VerticalAlignment="Top" Height="49" Width="94" Click="AddNewDroneClick"/>
            <Button x:Name="temp" Content="View the drones list" HorizontalAlignment="Left" Margin="249,328,0,0" VerticalAlignment="Top" Height="49" Width="123" Click="main"/>
            <Label Content="Id:" HorizontalAlignment="Left" Margin="240,129,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.093,1.715" Width="104" Height="28" />
            <Label Content="Model:" HorizontalAlignment="Left" Margin="240,178,0,0" VerticalAlignment="Top" Width="90" Height="27" />
            <Label Content="Max weight:" HorizontalAlignment="Left" Margin="240,217,0,0" VerticalAlignment="Top" Width="104" Height="27"/>
            <TextBox x:Name="stationId" HorizontalAlignment="Left" Margin="454,260,0,0" VerticalAlignment="Top" Width="120"/>
            <Label Content="Station id:" HorizontalAlignment="Left" Margin="239,260,0,0" VerticalAlignment="Top" Width="70" RenderTransformOrigin="0.5,0.5" />
        </Grid>
        <Grid x:Name="Actions" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions >
            <Label Content="Id:" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Model:" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Max weight:" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Id:" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Id:" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Id:" Grid.Column="1" Grid.Row="6" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Id:" Grid.Column="1" Grid.Row="7" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <Label Content="Id:" Grid.Column="1" Grid.Row="8" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"/>
            <TextBox x:Name="idText" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Id}" />
            <TextBox x:Name="modelText" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Model}" />
            <TextBox x:Name="batteryText" Grid.Column="2" Grid.Row="5" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Battery}"/>
            <TextBox x:Name="longitudeText" Grid.Column="2" Grid.Row="6" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Longitude}" />
            <TextBox x:Name="latitudeText" Grid.Column="2" Grid.Row="7" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" Text="{Binding Path=Latitude}"/>
            <TextBox x:Name="parcelNumberText" Grid.Column="2" Grid.Row="8" HorizontalAlignment="Stretch" TextWrapping="Wrap" VerticalAlignment="Stretch" />
            <ComboBox x:Name="maxWeightText" Grid.Column="2" HorizontalAlignment="Stretch" Grid.Row="3" VerticalAlignment="Stretch" SelectedItem="{Binding Path=MaxWeight}"/>
            <ComboBox x:Name="statusText" Grid.Column="2" HorizontalAlignment="Stretch" Grid.Row="4" VerticalAlignment="Stretch" Text="{Binding Path=Status}"/>
            <Button x:Name="UpdateModel" Content="Updat model" Grid.Column="3" HorizontalAlignment="Left" Margin="82,24,0,0" Grid.Row="9" VerticalAlignment="Top" Click="UpdateModelClick"/>
            <Button Content="Button" HorizontalAlignment="Left" Margin="2,21,0,0" VerticalAlignment="Top" RenderTransformOrigin="-2.08,-0.078" Click="Button_Click"/>
            <Button x:Name="charging" Content="Charging" Grid.Column="2" HorizontalAlignment="Left" Margin="173,24,0,0" Grid.Row="9" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="53" Click="ChargingClick"/>
            <Button x:Name="Release" Content="Release" Grid.Column="2" HorizontalAlignment="Left" Margin="78,25,0,0" Grid.Row="9" VerticalAlignment="Top" Click="ReleaseClick"/>
            <Button x:Name="Collection" Content="Collection" Grid.Column="1" HorizontalAlignment="Left" Margin="175,26,0,0" Grid.Row="9" VerticalAlignment="Top" Grid.ColumnSpan="2" Click="CollectionClick"/>
            <Button x:Name="Delivery" Content="Delivery" Grid.Column="1" HorizontalAlignment="Left" Margin="90,29,0,0" Grid.Row="9" VerticalAlignment="Top" Click="DeliveryClick"/>
        </Grid>
    </Grid>
</Window>
