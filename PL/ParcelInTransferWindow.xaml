<Window x:Class="PL.ParcelInTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL" d:DataContext="{d:DesignInstance Type=local:DronePO}"
        mc:Ignorable="d"
        Icon="image/2.jpeg"

        Title="ParcelInTransfer" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid>
        <Grid x:Name="Actions" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.5*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="145*"/>
                <ColumnDefinition Width="145*"/>
                <ColumnDefinition Width="73*"/>
                <ColumnDefinition Width="97*"/>
                <ColumnDefinition Width="49*"/>
                <ColumnDefinition Width="145*"/>
                <ColumnDefinition Width="145*"/>
            </Grid.ColumnDefinitions >
            <Label Content="Id:" Grid.Column="0" Grid.Row="1" FontWeight="Bold" FontSize="14"/>
            <Label Content="Id:" Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="3" Margin="48,0,145,0" FontWeight="Bold"/>
            <Label Content="Id:" Grid.Column="4" Grid.Row="2" Grid.ColumnSpan="3" Margin="48,38,145,38" Grid.RowSpan="3" FontWeight="Bold"/>
            <Label Content="Name:" Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="3" Margin="48,37,145,0" Grid.RowSpan="2" FontWeight="Bold"/>
            <Label Content="Name:" Grid.Column="4" Grid.Row="4" Grid.ColumnSpan="3" Margin="48,0,145,37" Grid.RowSpan="2" FontWeight="Bold"/>
            <Label Content="Parcel status:" Grid.Column="0" Grid.Row="8" Margin="0,0,0,75" Grid.RowSpan="2" FontWeight="Bold" FontSize="14"/>
            <Label Content="Max weight:" Grid.Column="0" Grid.Row="2" Margin="0,38,0,38" Grid.RowSpan="3" FontSize="14" FontWeight="Bold"/>
            <Label Content="Priority:" Grid.Column="0" Grid.Row="5" FontSize="14" FontWeight="Bold"/>
            <Label Content="Transport distance:" Grid.Column="0" Grid.Row="6" Margin="0,38,0,38" Grid.RowSpan="3" FontSize="14" FontWeight="Bold"/>
            <Label Content="Longitude:" Grid.Column="4" Grid.Row="5" Grid.ColumnSpan="3" Margin="48,0,145,0" FontWeight="Bold"/>
            <Label Content="Longitude:" Grid.Column="4" Grid.Row="6" Grid.ColumnSpan="3" Margin="48,38,145,0" Grid.RowSpan="3" FontWeight="Bold" Height="38" VerticalAlignment="Top"/>
            <Label Content="Latitude:" Grid.Column="4" Grid.Row="5" Grid.ColumnSpan="3" Margin="48,37,145,0" Grid.RowSpan="2" FontStyle="Italic" FontWeight="Bold"/>
            <Label Content="Latitude:" Grid.Column="4" Grid.Row="8" Grid.ColumnSpan="3" Margin="48,0,145,75" Grid.RowSpan="2" FontWeight="Bold"/>
            <Label Content="Sender:" Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2" FontWeight="Bold"/>
            <Label Content="Recipient:" Grid.Column="3" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,38,0,38" Grid.RowSpan="3" FontWeight="Bold"/>
            <Label Content="Collection location:" Grid.Column="3" Grid.Row="5" Grid.ColumnSpan="2" FontWeight="Bold"/>
            <Label Content="Target location:" Grid.Column="3" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,38,0,38" Grid.RowSpan="3" FontWeight="Bold"/>

            <TextBox x:Name="idText" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Path=Id}" Grid.ColumnSpan="3" Margin="145,0,73,0" />
            <TextBox x:Name="senderIdText" Grid.Column="6" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Path=Id}" />
            <TextBox x:Name="recipientIdText" Grid.Column="6" Grid.Row="2" TextWrapping="Wrap" Text="{Binding Path=Id}" Margin="0,38,0,38" Grid.RowSpan="3" />
            <TextBox x:Name="senderNameText" Grid.Column="6" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Path=Name}" Margin="0,37,0,0" Grid.RowSpan="2" />
            <TextBox x:Name="recipientNameText" Grid.Column="6" Grid.Row="4" TextWrapping="Wrap" Text="{Binding Path=Name}" Margin="0,0,0,37" Grid.RowSpan="2" />

            <TextBox x:Name="TransportDistanceText" Grid.Row="6" TextWrapping="Wrap" Text="{Binding Path=TransportDistance}" Grid.ColumnSpan="3" Margin="145,38,73,38" Grid.RowSpan="3"/>
            <TextBox x:Name="senderLongitudeText" Grid.Column="6" Grid.Row="5" TextWrapping="Wrap" Text="{Binding Path=Longitude}" />
            <TextBox x:Name="recipientLongitudeText" Grid.Column="6" Grid.Row="6" TextWrapping="Wrap" Text="{Binding Path=Longitude}" Margin="0,38,0,38" Grid.RowSpan="3" />
            <TextBox x:Name="senderLatitudeText" Grid.Column="6" Grid.Row="5" TextWrapping="Wrap" Text="{Binding Path=Latitude}" Margin="0,37,0,0" Grid.RowSpan="2"/>
            <TextBox x:Name="recipientLatitudeText" Grid.Column="6" Grid.Row="8" TextWrapping="Wrap" Text="{Binding Path=Latitude}" Margin="0,0,0,75" Grid.RowSpan="2"/>

            <ComboBox x:Name="maxWeightText" Grid.Row="2" SelectedItem="{Binding Path=Weight}" Grid.ColumnSpan="3" Margin="145,38,73,38" Grid.RowSpan="3"/>
            <ComboBox x:Name="PriorityText" Grid.Row="5" Text="{Binding Path=Priority}" Grid.ColumnSpan="3" Margin="145,0,73,0"/>
            <CheckBox x:Name="ParcelStatusText" Content="On the way to the destination"  Grid.Row="8" Grid.ColumnSpan="3" Margin="145,0,35,2" />
            <Button x:Name="close" Content="close" Click="CloseClick" Margin="0,0,0,37" Grid.RowSpan="2"/>
        </Grid>

    </Grid>
</Window>
