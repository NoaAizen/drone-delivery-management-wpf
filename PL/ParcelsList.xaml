<Window x:Class="PL.ParcelsList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="ParcelsList" Height="450" Width="800" WindowStyle="None" MouseDown="moveWindow">
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="251*"/>
            <ColumnDefinition Width="149*"/>
            <ColumnDefinition Width="150*"/>
            <ColumnDefinition Width="105*"/>
            <ColumnDefinition Width="145*"/>
        </Grid.ColumnDefinitions >
        <ComboBox x:Name="StatusSelector" Grid.Column="4"  SelectionChanged="StatusSelectorSelectionChanged" Margin="0,31,0,41" Grid.RowSpan="2"  />
        <Button x:Name="Grouping" Content="Sender Id" Click="GroupingClick" Margin="148,30,104,7" Grid.ColumnSpan="3" Grid.Column="1" FontWeight="Bold" FontSize="20"  />
        <Label Content="status:" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" FontSize="20"  FontWeight="Bold" Grid.Column="3" Grid.Row="0" Margin="17,29,10,11" />
        <ListView x:Name="parcelsList" ItemsSource="{Binding}" MouseDoubleClick="GetActions" Margin="0,72,0,10" Grid.RowSpan="9" Grid.ColumnSpan="5">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Sender Name" DisplayMemberBinding="{Binding SenderName}"/>
                    <GridViewColumn Header="Recipient Name" DisplayMemberBinding="{Binding RecipientName}"/>
                    <GridViewColumn Header="Weight" DisplayMemberBinding="{Binding Weight}"/>
                    <GridViewColumn Header="Priority" DisplayMemberBinding="{Binding Priority}"/>
                    <GridViewColumn Header="Status Parcel" DisplayMemberBinding="{Binding StatusParcel}"/>


                </GridView>
            </ListView.View>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="Name" FontWeight="Bold" FontSize="14" Text="{Binding Name}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>
        <Button x:Name="addParcel" Content="Add new parcel" Grid.Row="8" Grid.ColumnSpan="5" FontSize="20" FontWeight="Bold" Click="ShowAddParcelWindow" Margin="0,41,0,0" Grid.RowSpan="2"/>
        <Button x:Name="close" Content="Close" HorizontalAlignment="Left"  VerticalAlignment="Top" RenderTransformOrigin="-1.161,0.202" Click="CloseClick" Height="31" Width="100" FontStyle="Normal" FontWeight="Bold" FontSize="20"/>

    </Grid>
</Window>
