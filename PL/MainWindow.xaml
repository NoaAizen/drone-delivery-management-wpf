<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
   
    
    
    <Window.Background>
        <ImageBrush ImageSource="image/רקע.png" />
    </Window.Background>

    <Grid>
        <Button Content="Manager" HorizontalAlignment="Left" Margin="176,275,0,0" VerticalAlignment="Top" Height="78" Width="150" FontWeight="Bold" FontFamily="Segoe UI Black" BorderThickness="0,0,0,0" Background="#FFD8B8E2" FontSize="20" Click="ManagerClick" >
        </Button>
        <Button Content="Client" HorizontalAlignment="Left" Margin="334,276,0,0" VerticalAlignment="Top" Height="75" Width="150" FontWeight="Bold" FontFamily="Segoe UI Black" BorderThickness="0,0,0,0" Background="#FFD8B8E2" FontSize="20" Click="ClientClick">
        </Button>
        <Button Content="New Client" HorizontalAlignment="Left" Margin="491,277,0,0" VerticalAlignment="Top" Height="75" Width="150" FontWeight="Bold" FontFamily="Segoe UI Black" BorderThickness="0,0,0,0" Background="#FFD8B8E2" FontSize="20" Click="NewClicentClick">
        </Button>
        <Image Source="image/לוגו עם מסגרת.png" Margin="234,8,224,141"  />
    </Grid>
</Window>
