<Window x:Class="PL.ParcelAtCustomerFromCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL" d:DataContext="{d:DesignInstance Type=local:CustomerPo}"
        mc:Ignorable="d"
        Title="ParcelAtCustomerFromCustomer" Height="450" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid x:Name="ParcelAtCustomerFromCustomers" Margin="0,-1,0,1">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="73*"/>
            <ColumnDefinition Width="97*"/>
            <ColumnDefinition Width="49*"/>
            <ColumnDefinition Width="145*"/>
            <ColumnDefinition Width="145*"/>
        </Grid.ColumnDefinitions >
        <Label Content="Id:" Grid.Column="0" Grid.Row="1" FontWeight="Bold" FontSize="14"/>
        <Label Content="Id:" Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="3" Margin="48,0,145,0" FontWeight="Bold"/>
        <Label Content="Name:" Grid.Column="4" Grid.Row="1" Grid.ColumnSpan="3" Margin="48,37,145,0" Grid.RowSpan="2" FontWeight="Bold"/>
        <Label Content="Max weight:" Grid.Column="0" Grid.Row="2" Margin="0,38,0,38" Grid.RowSpan="3" FontSize="14" FontWeight="Bold"/>
        <Label Content="Priority:" Grid.Column="0" Grid.Row="5" FontSize="14" FontWeight="Bold"/>
        <Label Content="Status parcel:" Grid.Column="0" Grid.Row="6" Margin="0,38,0,38" Grid.RowSpan="3" FontSize="14" FontWeight="Bold"/>
        <TextBox x:Name="idText" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Path=Id}" Grid.ColumnSpan="3" Margin="145,0,73,0" />
        <TextBox x:Name="preclIdText" Grid.Column="6" Grid.Row="1" TextWrapping="Wrap" Text="{Binding Path=idtemp}" />
        <ComboBox x:Name="maxWeightText" Grid.Row="2" SelectedItem="{Binding Path=Weight}" Grid.ColumnSpan="3" Margin="145,38,73,38" Grid.RowSpan="3"/>
        <ComboBox x:Name="PriorityText" Grid.Row="5" Text="{Binding Path=Priority}" Grid.ColumnSpan="3" Margin="145,0,73,0"/>
        <TextBox x:Name="preclnameText" Grid.Column="6" Grid.Row="2" TextWrapping="Wrap" Text="{Binding Path=Id}" />

        <ComboBox x:Name="StatusParcelText" Grid.Column="1" HorizontalAlignment="Center" Margin="0,1,0,0" Grid.Row="7" VerticalAlignment="Top" Width="142" Height="30" Text="{Binding Path=StatusParcel}"/>
        <Label Content="Customer In Parcel:" Grid.Column="2" Grid.Row="1" Height="37" Grid.ColumnSpan="4" Margin="53,0,138,0"/>
        <Button x:Name="close" Content="close" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="CcloseClick" />
    </Grid>
</Window>
