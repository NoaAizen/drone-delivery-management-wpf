<Window x:Class="PL.DroneLists"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Icon="image/2.jpeg"
        Title="DroneLists" Height="640" Width="800"
          WindowStyle="None" MouseDown="moveWindow">

    <Window.Resources>
        <Color x:Key="SolidColorBrushColor1">#FF030B21</Color>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid>
        <Grid Name="MainGrid">
            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="273*"/>
                <ColumnDefinition Width="527*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>

                <RowDefinition Height="74*"/>
                <RowDefinition Height="477*"/>
                <RowDefinition Height="73*"/>
            </Grid.RowDefinitions>
            <Grid Name="UpGrid" Height="auto" Grid.Row="0" Width="auto" Margin="11,-3,3,9" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="37*"/>
                    <RowDefinition Height="31*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="147*"/>
                    <ColumnDefinition Width="147*"/>
                    <ColumnDefinition Width="151*"/>
                    <ColumnDefinition Width="157*"/>
                    <ColumnDefinition Width="157*"/>

                    <ColumnDefinition/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions >
                <ComboBox Name="StatusSelector" HorizontalContentAlignment="Stretch" SelectionChanged="StatusSelector_SelectionChanged"  Grid.Column="2" Grid.Row="1"  />
                <Label Content="status:" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="16"  FontWeight="Bold" Grid.Column="1" Grid.Row="1"/>
                <ComboBox x:Name="WeightSelector" HorizontalContentAlignment="Center" Grid.Column="4" SelectionChanged="WeightSelector_SelectionChanged" Grid.Row="1"/>
                <Label Content="drone:" Grid.Column="0"  FontSize="16" FontWeight="Bold"  VerticalAlignment="Stretch" HorizontalContentAlignment="Right" Grid.Row="1"/>

                <Label Content="max weight:" Grid.Column="3"  FontSize="16" FontWeight="Bold"  VerticalAlignment="Center" HorizontalContentAlignment="Center" Grid.Row="1"/>
                <Button x:Name="close" Content="Close" HorizontalAlignment="Left" Margin="-6,2,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.161,0.202" Click="CloseClick" Height="31" Width="100" FontStyle="Normal" FontWeight="Bold" FontSize="20"/>
            </Grid>
            <ListView x:Name="DroneListsView"  Margin="1,69,-1,16" MouseDoubleClick="GetActions" ItemsSource="{Binding}" Grid.ColumnSpan="2" FontWeight="Bold" Grid.RowSpan="2">
                <ListView.Foreground>
                    <SolidColorBrush Color="{DynamicResource SolidColorBrushColor1}"/>
                </ListView.Foreground>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Model" DisplayMemberBinding="{Binding Model}"/>
                        <GridViewColumn Header="MaxWeight" DisplayMemberBinding="{Binding MaxWeight}"/>
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="Battery" DisplayMemberBinding="{Binding Battery}"/>
                        <GridViewColumn Header="Parcel In Transfer" DisplayMemberBinding="{Binding ParcelInTransfer}"/>
                        <GridViewColumn Header="CurrentLocation" DisplayMemberBinding="{Binding CurrentLocation}"/>
                        <GridViewColumn Header="ParcelTransferredNumber" DisplayMemberBinding="{Binding ParcelTransferredNumber}"/>

                    </GridView>
                </ListView.View>
            </ListView>
            <Button x:Name="AddDrone" Content="Add new drone"  Grid.Row="2" Click="ShowAddDroneWindow" Grid.ColumnSpan="2" FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
        </Grid>
    </Grid>
</Window>
