<Window x:Class="PL.DroneLists"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Icon="image/2.jpeg"
        Title="DroneLists" Height="640" Width="800">
    <Window.Resources>
        <Color x:Key="SolidColorBrushColor1">#FF030B21</Color>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid>
        <Grid Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="97*"/>
                <ColumnDefinition Width="303*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="74*"/>
                <RowDefinition Height="477*"/>
                <RowDefinition Height="73*"/>
            </Grid.RowDefinitions>
            <Grid Name="UpGrid" Height="auto" Grid.Row="0" Width="auto" Margin="6,0,-6,0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="256*"/>
                    <ColumnDefinition Width="167*"/>
                    <ColumnDefinition Width="192*"/>
                    <ColumnDefinition Width="167*"/>
                </Grid.ColumnDefinitions >
                <ComboBox Name="StatusSelector" Grid.Column="1"  SelectionChanged="StatusSelector_SelectionChanged" RenderTransformOrigin="-0.268,0.01" Margin="2,41,3,-1"/>
                <Label Content="Drone status:" FontSize="20" VerticalAlignment="Top" FontWeight="Bold" Grid.Column="0" Grid.Row="0" Height="40" Margin="121,39,1,0"/>
                <ComboBox x:Name="WeightSelector" Grid.Column="3" SelectionChanged="WeightSelector_SelectionChanged" Margin="2,39,6,1"/>
                <Label Content="Drone max weight:" Grid.Column="2"  FontSize="20" FontWeight="Bold" Margin="4,35,2,2"/>
                <Button x:Name="close" Content="Close" HorizontalAlignment="Left" Margin="-6,2,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.161,0.202" Click="CloseClick" Height="31" Width="100" FontStyle="Normal" FontWeight="Bold" FontSize="20"/>
            </Grid>
            <ListView x:Name="DroneListsView"  Margin="0,13,0,10" Grid.Row="1" MouseDoubleClick="GetActions" ItemsSource="{Binding}" Grid.ColumnSpan="2" FontWeight="Bold">
                <ListView.Foreground>
                    <SolidColorBrush Color="{DynamicResource SolidColorBrushColor1}"/>
                </ListView.Foreground>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Model" DisplayMemberBinding="{Binding Model}"/>
                        <GridViewColumn Header="MaxWeight" DisplayMemberBinding="{Binding MaxWeight}"/>
                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}"/>
                        <GridViewColumn Header="Battery" DisplayMemberBinding="{Binding Battery}"/>
                        <GridViewColumn Header="Parcel In Transfer" DisplayMemberBinding="{Binding ParcelInTransfer}"/>
                        <GridViewColumn Header="CurrentLocation" DisplayMemberBinding="{Binding CurrentLocation}"/>
                        <GridViewColumn Header="ParcelTransferredNumber" DisplayMemberBinding="{Binding ParcelTransferredNumber}"/>

                    </GridView>
                </ListView.View>
            </ListView>
            <Button x:Name="AddDrone" Content="Add new drone"  Grid.Row="2" Click="ShowAddDroneWindow" Grid.ColumnSpan="2" FontSize="20" FontWeight="Bold" Margin="0,5,0,0" />
        </Grid>
    </Grid>
</Window>
