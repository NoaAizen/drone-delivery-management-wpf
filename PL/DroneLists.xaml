<Window x:Class="PL.DroneLists"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Icon="image/2.jpeg"
        Title="DroneLists" Height="640" Width="800">
    <Window.Resources>
        <Color x:Key="SolidColorBrushColor1">#FF030B21</Color>
    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="image/1.jpg" />
    </Window.Background>
    <Grid>
        <Grid Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="97*"/>
                <ColumnDefinition Width="303*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="400*"/>
                <RowDefinition Height="60*"/>
            </Grid.RowDefinitions>
            <Grid Name="UpGrid" Height="auto" Grid.Row="0" Width="auto" Margin="6,0,-6,0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200*"/>
                    <ColumnDefinition Width="200*"/>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="137*"/>
                    <ColumnDefinition Width="200*"/>
                </Grid.ColumnDefinitions >
                <ComboBox Name="StatusSelector" Grid.Column="1"  SelectionChanged="StatusSelector_SelectionChanged" RenderTransformOrigin="-0.268,0.01" Grid.ColumnSpan="2" Margin="8,0,52,0"/>
                <Label Content="Drone &#xD;&#xA;status:" Grid.Column="0" FontSize="20" Margin="121,-1,3,3" FontWeight="Bold"/>
                <ComboBox x:Name="WeightSelector" Grid.Column="4" SelectionChanged="WeightSelector_SelectionChanged" Grid.ColumnSpan="2" Margin="127,0,10,0"/>
                <Label Content="Drone max &#xD;&#xA;weight:" Grid.Column="4"  FontSize="16" FontWeight="Bold" Margin="23,0,197,0" Grid.ColumnSpan="2"/>
                <Button x:Name="close" Content="Close" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="-1.161,0.202" Click="CloseClick" Height="59" Width="77" FontStyle="Normal" FontWeight="Bold"/>
            </Grid>
            <ListView x:Name="DroneListsView"  Margin="0,8,0,10" Grid.Row="1" MouseDoubleClick="GetActions" ItemsSource="{Binding}" Grid.ColumnSpan="2">
                <ListView.Foreground>
                    <SolidColorBrush Color="{DynamicResource SolidColorBrushColor1}"/>
                </ListView.Foreground>
                <ListView.View>
                    <GridView>
                        <GridViewColumn/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Button x:Name="AddDrone" Content="Add new drone"  Grid.Row="2" Click="ShowAddDroneWindow" Grid.ColumnSpan="2" FontSize="20" FontWeight="Bold" />
        </Grid>
    </Grid>
</Window>
