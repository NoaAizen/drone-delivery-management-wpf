<Window x:Class="PL.DroneLists"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="DroneLists" Height="640" Width="800">
    <Grid>
        <Grid Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="400*"/>
                <RowDefinition Height="60*"/>
            </Grid.RowDefinitions>
            <Grid Name="UpGrid" Height="auto" Grid.Row="0" Width="auto" Margin="6,0,-6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions >
                <ComboBox Name="StatusSelector" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  SelectionChanged="StatusSelector_SelectionChanged" RenderTransformOrigin="-0.268,0.01"/>
                <Label Content="Drone status:" Grid.Column="0" FontSize="22"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <ComboBox x:Name="WeightSelector" Grid.Column="2" SelectionChanged="WeightSelector_SelectionChanged" Grid.ColumnSpan="2" Margin="190,0,10,0"/>
                <Label Content="Drone max weight:" Grid.Column="2" Margin="0,-1,0,0" FontSize="22"/>
            </Grid>
            <ListView x:Name="DroneListsView"  Margin="0,8,0,10" Grid.Row="1" MouseDoubleClick="GetActions" ItemsSource="{Binding}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Button x:Name="AddDrone" Content="Add new drone" HorizontalAlignment="Stretch"  Grid.Row="2" VerticalAlignment="Stretch" Click="ShowAddDroneWindow" />
        </Grid>
    </Grid>
</Window>
