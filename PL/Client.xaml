<Window x:Class="PL.Client"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Client" Height="450" Width="800"
          
        >
          
    
    <Grid x:Name="ClientMian" Margin="2,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="72*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="71*"/>
            <RowDefinition Height="72*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232*"/>
            <ColumnDefinition Width="197*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="197*"/>
            <ColumnDefinition Width="160*"/>
        </Grid.ColumnDefinitions >

        <Button Content="Add a parcel"   Click="AddParcelClick" Grid.Column="1" Grid.ColumnSpan="3" Margin="47,2,136,16" Grid.Row="9" />
        <ListView x:Name="ParcelAtCustomerFromCustomerID"  Grid.Row="2" Grid.ColumnSpan="2" Margin="-5,32,64,4" Grid.RowSpan="7" ItemsSource="{Binding}" SelectionChanged="ParcelAtCustomerFromCustomerID_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
        <ListView  x:Name="ParcelAtCustomerToCustomerID" ItemsSource="{Binding}" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3" Margin="10,0,5,3" Grid.RowSpan="6">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Content="parcels from customer:" HorizontalAlignment="Left"  VerticalAlignment="Top" Grid.Row="2"/>
        <Label Content="parcels to customer:" HorizontalAlignment="Left"  VerticalAlignment="Top" Grid.Row="2" Grid.Column="3"/>
        <Button Content="Button" HorizontalAlignment="Left" Margin="140,10,0,0" Grid.Row="1" VerticalAlignment="Top" Click="Button_Click_1" />

        <!--<Button Content="Sending a parcel "  FontWeight="Bold" FontFamily="Segoe UI Black"  Grid.RowSpan="5" Grid.Row="2" Click="SendingParcelClick" Margin="37,14,195,22" Grid.ColumnSpan="2"/>-->
        <!--<Button Content="אישור שליחת חבילה" FontWeight="Bold" FontFamily="Segoe UI Black" BorderThickness="0,0,0,0" Background="#FFD8B8E2" FontSize="20"  Grid.Column="5" Grid.RowSpan="2" Grid.Row="8"  />-->
         
    </Grid>

</Window>
