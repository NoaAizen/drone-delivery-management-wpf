<Window x:Class="PL.Client"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Title="Client" Height="450" Width="800"
          WindowStyle="None" MouseDown="moveWindow"
        >


    <Grid x:Name="ClientMian" >
        <Grid.RowDefinitions>
            <RowDefinition Height="72*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="35*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="71*"/>
            <RowDefinition Height="72*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="233*"/>
            <ColumnDefinition Width="198*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="198*"/>
            <ColumnDefinition Width="198*"/>
        </Grid.ColumnDefinitions >

        <Button Content="Add new parcel"  FontSize="20" FontWeight="Bold" Click="AddParcelClick" Grid.Column="1" Grid.ColumnSpan="3" Margin="47,2,136,16" Grid.Row="9" />
        <ListView x:Name="ParcelAtCustomerFromCustomerID"  Grid.Row="2" Grid.ColumnSpan="2" Margin="9,32,50,4" Grid.RowSpan="7" ItemsSource="{Binding}" SelectionChanged="ParcelAtCustomerFromCustomerID_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
        <ListView  x:Name="ParcelAtCustomerToCustomerID" ItemsSource="{Binding}" Grid.Column="2" Grid.Row="3" Grid.ColumnSpan="3" Margin="10,0,5,3" Grid.RowSpan="6" SelectionChanged="ParcelAtCustomerToCustomerID_SekectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
        <Label Content="parcels from customer:" HorizontalAlignment="Left"  VerticalAlignment="Top" Grid.Row="1" Height="26" Margin="14,37,0,0" Grid.RowSpan="2" Width="131"/>
        <Label Content="parcels to customer:" HorizontalAlignment="Left"  VerticalAlignment="Top" Grid.Row="1" Grid.Column="3" Height="26" Margin="0,37,0,0" Grid.RowSpan="2" Width="117"/>
        <Button Content="Contact Us" Grid.Row="0" Grid.Column="3" Click="Button_Click_1" FontSize="14"    />
        <Button x:Name="close" Content="Close" HorizontalAlignment="Left"  VerticalAlignment="Top" RenderTransformOrigin="-1.161,0.202" Click="CloseClick" Height="31" Width="100" FontStyle="Normal" FontWeight="Bold" FontSize="20"/>
        <Button Content="Update details" Grid.Column="4" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" Click="Button_Click" FontSize="14" />

        <!--<Button Content="Sending a parcel "  FontWeight="Bold" FontFamily="Segoe UI Black"  Grid.RowSpan="5" Grid.Row="2" Click="SendingParcelClick" Margin="37,14,195,22" Grid.ColumnSpan="2"/>-->
        <!--<Button Content="אישור שליחת חבילה" FontWeight="Bold" FontFamily="Segoe UI Black" BorderThickness="0,0,0,0" Background="#FFD8B8E2" FontSize="20"  Grid.Column="5" Grid.RowSpan="2" Grid.Row="8"  />-->

    </Grid>

</Window>
